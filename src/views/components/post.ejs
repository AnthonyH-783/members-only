<div class="post <%=post.role%>">
    <div class="post__top">
        <h4 class="post__title">
            <%=post.title%>
        </h4>
        <%- include("status-badge", {role: post.role}) %>

    </div>

    <div class="post__middle">
        <p>
            <%=post.message%>
        </p>
    </div>

    <div class="post__bottom">
        
        <%- include("user-datetime", {
            firstName: post.firstName,
            lastName: post.lastName,
            createdAt: post.createdAt
        
        }) %>
        <% if(currentUser && (currentUser.role === "admin" || currentUser.id === post.userId)){ %>
            <form action="/posts/<%=post.id%>/delete" method="get">
                <button class="post__delete-btn " type="submit">Delete</button>
            </form>
        <% } %>
    </div>
</div>