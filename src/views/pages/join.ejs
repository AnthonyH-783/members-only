<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <title>Join</title>
</head>
<body>
    <div class="auth-page">
      <a class="go-back" href="/">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      </a>
      

  <form class="auth-card" action="/forms/join" method="POST">

    <div class="auth-header">
      <h1 class="auth-title">Join the club!</h1>
      <p class="auth-subtitle">
        Enter the secret passcode to obtain member status
      </p>
        <% if(locals.error){ %>
          <div class="error">
              <span><%=error%></span>
          </div>

        <%} %>
    </div>

    <div class="auth-body">

      <div class="auth-field">
        <label for="password" class="auth-label">Passcode</label>
        <input
          type="password"
          id="password"
          name="password"
          class="auth-input"
          placeholder="••••••••"
          required
        />
      </div>

    </div>

    <div class="auth-actions">

      <button type="submit" class="auth-button auth-button--primary font-bold">
        Join
      </button>


    </div>

  </form>

</div>
    
</body>
</html>